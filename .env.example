# Copy to .env and fill in. .env never reaches git -- see .gitignore.
# The .NET equivalent is appsettings.Development.json, which you do not commit.

# --- LLM provider (phase 3 only; netshift works fine without any of this) ---
# Anthropic key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Which provider netshift uses: anthropic | openai | none
NETSHIFT_LLM_PROVIDER=none
NETSHIFT_LLM_MODEL=claude-sonnet-5

# --- Store ---
# memory   -- everything in process memory, nothing to install
# postgres -- requires docker compose to be up
NETSHIFT_STORE=memory

POSTGRES_USER=netshift
POSTGRES_PASSWORD=netshift_local_only
POSTGRES_DB=netshift
# Use the address, not "localhost": on Windows the name resolves to ::1 first
# and the connection hangs, because the port is published on IPv4 only.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT=10

# --- Misc ---
NETSHIFT_LOG_LEVEL=INFO
